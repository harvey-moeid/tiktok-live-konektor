NODE_ENV=production
PORT=10000
# One trusted reverse proxy (Render); use 0 for a direct server.
TRUST_PROXY=1
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
TIKTOK_USERNAME=jalurtarot
TIKTOK_ROOM_ID=
EULER_API_KEY=
# Community Cloud WebSocket is tried automatically after a Business-only Node signer error.
# This is independent of Eulerstream's Business-only signature endpoint.
JWT_SECRET=change-this-to-at-least-32-characters
WS_TOKEN=change-this-to-a-long-random-token
API_KEY=change-this-to-a-separate-long-random-api-key
API_ALLOWED_ORIGINS=https://example.com
CONFIG_FILE=./data/config.json
MAX_FEED_EVENTS=500
MAX_EVENT_BYTES=65536
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_RETRIES=3
# Required to enable webhooks in production; use an independent random 32+ character secret.
WEBHOOK_SIGNING_SECRET=
TIKTOK_HTTP_TIMEOUT_MS=10000
TIKTOK_DEBUG=false

# Optional Python connector fallback (requires a deployed Python web service)
# Set HTTPS origin, or supply PYTHON_FALLBACK_HOSTNAME manually.
PYTHON_FALLBACK_URL=
PYTHON_FALLBACK_HOSTNAME=
PYTHON_FALLBACK_TOKEN=
